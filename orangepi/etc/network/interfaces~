source /etc/network/interfaces.d/*

# Loopback
auto lo
iface lo inet loopback

# ETH0 для IPv4
auto eth0
iface eth0 inet static
        address 192.168.6.42
        netmask 255.255.255.0
        gateway 192.168.6.25

# ETH0 IPv6 — только адрес, без gateway
iface eth0 inet6 static
        address bbbb::1
        netmask 64
	gateway bbbb::100
